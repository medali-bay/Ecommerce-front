* {
  box-sizing: border-box;
}

:root {
  --blue-900: #071a3d;
  --blue-800: #0b2f6b;
  --blue-700: #1247a4;
  --blue-600: #1d5fe8;
  --blue-100: #eaf2ff;
  --blue-050: #f5f9ff;
  --white: #ffffff;
  --black: #07111f;
  --text: #0f172a;
  --muted: #64748b;
  --soft: #f6f8fb;
  --line: #dbe7f5;
  --green: #0f9f6e;
  --orange: #f59e0b;
  --red: #dc2626;
  --shadow: 0 22px 60px rgba(7, 26, 61, 0.12);
  --radius-xl: 30px;
  --radius-lg: 22px;
  --radius-md: 16px;
}

body {
  margin: 0;
  background: linear-gradient(180deg, var(--blue-050), #ffffff 42%, #f8fbff);
  color: var(--text);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  border: 0;
  background: transparent;
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.45;
}

input,
select,
textarea {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 13px 14px;
  background: var(--white);
  color: var(--text);
  outline: none;
}

textarea {
  min-height: 92px;
  resize: vertical;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--blue-600);
  box-shadow: 0 0 0 4px rgba(29, 95, 232, 0.12);
}

.app-shell {
  width: min(1440px, 100%);
  margin: 0 auto;
  padding: 22px;
}

.site-header {
  position: sticky;
  top: 14px;
  z-index: 20;
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 18px;
  align-items: center;
  padding: 14px;
  margin-bottom: 22px;
  border: 1px solid rgba(219, 231, 245, 0.8);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  box-shadow: 0 14px 40px rgba(7, 26, 61, 0.08);
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--blue-900);
  font-size: 18px;
  font-weight: 950;
  letter-spacing: -0.04em;
}

.brand-mark span {
  display: grid;
  width: 38px;
  height: 38px;
  place-items: center;
  border-radius: 50%;
  background: var(--blue-900);
  color: white;
  font-weight: 950;
}

.main-nav {
  display: flex;
  justify-content: center;
  gap: 4px;
}

.main-nav button,
.cart-chip,
.user-chip,
.outline-button,
.solid-button,
.ghost-light,
.text-button,
.solid-link {
  border-radius: 999px;
  font-weight: 850;
  text-decoration: none;
  transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease, border 0.18s ease;
}

.main-nav button {
  padding: 11px 16px;
  color: var(--muted);
}

.main-nav button:hover,
.main-nav button.active {
  background: var(--blue-100);
  color: var(--blue-800);
}

.header-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
}

.cart-chip,
.user-chip {
  padding: 11px 14px;
  background: var(--blue-100);
  color: var(--blue-800);
  white-space: nowrap;
}

.outline-button {
  padding: 11px 16px;
  border: 1px solid var(--line);
  background: white;
  color: var(--blue-800);
}

.outline-button.dark {
  border-color: rgba(255, 255, 255, 0.35);
  background: rgba(255, 255, 255, 0.1);
  color: white;
}

.solid-button,
.solid-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 18px;
  background: var(--blue-700);
  color: white;
}

.solid-button:hover,
.solid-link:hover,
.outline-button:hover,
.ghost-light:hover {
  transform: translateY(-1px);
}

.solid-button:hover,
.solid-link:hover {
  background: var(--blue-800);
}

.solid-button.full {
  width: 100%;
}

.ghost-light {
  padding: 12px 18px;
  background: var(--blue-100);
  color: var(--blue-800);
}

.text-button {
  color: var(--blue-700);
  font-weight: 900;
}

.text-button.danger {
  color: var(--red);
}

.hero-section {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 360px;
  gap: 22px;
  align-items: stretch;
  min-height: 470px;
  padding: 34px;
  margin-bottom: 22px;
  overflow: hidden;
  border-radius: var(--radius-xl);
  background:
    radial-gradient(circle at 78% 10%, rgba(255, 255, 255, 0.22), transparent 32%),
    linear-gradient(135deg, #061733 0%, #0c3478 45%, #1d5fe8 100%);
  color: white;
  box-shadow: var(--shadow);
}

.hero-copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.section-kicker {
  margin: 0 0 10px;
  color: var(--blue-600);
  font-size: 12px;
  font-weight: 950;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.hero-section .section-kicker {
  color: #9dccff;
}

.hero-copy h1 {
  max-width: 850px;
  margin: 0;
  font-size: clamp(46px, 7vw, 92px);
  line-height: 0.92;
  letter-spacing: -0.08em;
}

.hero-copy p:not(.section-kicker) {
  max-width: 650px;
  margin: 24px 0 0;
  color: #d8e9ff;
  font-size: 18px;
  line-height: 1.7;
}

.hero-cta-row {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 30px;
}

.hero-panel {
  align-self: end;
  padding: 26px;
  border: 1px solid rgba(255, 255, 255, 0.26);
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20px);
}

.hero-panel span,
.hero-panel p {
  color: #cfe4ff;
}

.hero-panel strong {
  display: block;
  margin: 8px 0 4px;
  font-size: 44px;
  letter-spacing: -0.06em;
}

.store-stats,
.admin-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 24px;
}

.store-stats div,
.admin-stats div {
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: white;
  box-shadow: 0 12px 28px rgba(7, 26, 61, 0.06);
}

.store-stats span,
.admin-stats span {
  display: block;
  color: var(--muted);
  font-size: 14px;
  margin-bottom: 8px;
}

.store-stats strong,
.admin-stats strong {
  font-size: 34px;
  letter-spacing: -0.05em;
}

.shop-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 380px;
  gap: 24px;
  align-items: start;
}

.section-title {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: end;
  margin-bottom: 16px;
}

.section-title h2 {
  margin: 0;
  font-size: clamp(32px, 4vw, 52px);
  line-height: 1;
  letter-spacing: -0.07em;
}

.section-title > p {
  max-width: 530px;
  margin: 0;
  color: var(--muted);
  line-height: 1.6;
}

.filter-bar {
  display: grid;
  grid-template-columns: 1.6fr 1.1fr 0.8fr 0.8fr 1.1fr auto auto;
  gap: 10px;
  padding: 14px;
  margin-bottom: 22px;
  border: 1px solid var(--line);
  border-radius: 24px;
  background: white;
  box-shadow: 0 14px 40px rgba(7, 26, 61, 0.06);
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 22px;
}

.product-card {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 26px;
  background: white;
  box-shadow: 0 18px 44px rgba(7, 26, 61, 0.08);
  transition: transform 0.22s ease, box-shadow 0.22s ease;
}

.product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 24px 60px rgba(7, 26, 61, 0.14);
}

.product-media {
  position: relative;
  height: 260px;
  overflow: hidden;
  background: linear-gradient(135deg, var(--blue-100), #ffffff);
}

.product-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-placeholder {
  display: grid;
  height: 100%;
  place-items: center;
  color: var(--blue-700);
  font-size: 80px;
  font-weight: 950;
  letter-spacing: -0.1em;
}

.status-badge {
  position: absolute;
  top: 14px;
  right: 14px;
  padding: 8px 12px;
  border-radius: 999px;
  background: white;
  font-size: 12px;
  font-weight: 950;
  box-shadow: 0 10px 28px rgba(7, 26, 61, 0.12);
}

.status-available {
  color: var(--green);
}

.status-limited,
.status-soon {
  color: var(--orange);
}

.status-out {
  color: var(--red);
}

.product-body {
  padding: 20px;
}

.product-meta-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  color: var(--muted);
  font-size: 13px;
  font-weight: 800;
}

.product-meta-row strong {
  color: var(--blue-900);
  font-size: 18px;
}

.product-body h3 {
  margin: 14px 0 8px;
  font-size: 24px;
  line-height: 1.05;
  letter-spacing: -0.05em;
}

.product-body p {
  min-height: 44px;
  margin: 0 0 18px;
  color: var(--muted);
  line-height: 1.5;
}

.product-cta {
  width: 100%;
  padding: 14px;
  border-radius: 999px;
  background: var(--blue-900);
  color: white;
  font-weight: 950;
}

.product-cta:hover:not(:disabled) {
  background: var(--blue-700);
}

.cart-card,
.auth-card,
.admin-card,
.table-card {
  border: 1px solid var(--line);
  border-radius: 28px;
  background: white;
  box-shadow: var(--shadow);
}

.cart-card {
  position: sticky;
  top: 104px;
  padding: 22px;
}

.cart-title {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: start;
  margin-bottom: 18px;
}

.cart-title h2,
.auth-card h2,
.admin-card h3 {
  margin: 0;
  letter-spacing: -0.05em;
}

.cart-title h2 {
  font-size: 34px;
}

.empty-cart-card,
.confirmation-card,
.state-card {
  display: grid;
  place-items: center;
  min-height: 210px;
  padding: 28px;
  border: 1px dashed var(--line);
  border-radius: 22px;
  text-align: center;
  color: var(--muted);
  background: var(--blue-050);
}

.confirmation-card {
  border: 1px solid rgba(15, 159, 110, 0.25);
  background: #edfff8;
}

.confirmation-card span {
  display: grid;
  width: 54px;
  height: 54px;
  place-items: center;
  border-radius: 50%;
  background: var(--green);
  color: white;
  font-size: 30px;
  font-weight: 950;
}

.confirmation-card h3 {
  margin: 12px 0 4px;
  color: #08734f;
  font-size: 26px;
}

.confirmation-card p {
  margin: 0 0 18px;
  color: #08734f;
  font-weight: 800;
}

.cart-items {
  display: grid;
  gap: 12px;
  max-height: 430px;
  overflow-y: auto;
  padding-right: 3px;
}

.cart-item {
  display: grid;
  grid-template-columns: 64px 1fr auto;
  gap: 12px;
  align-items: center;
  padding: 10px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--soft);
}

.mini-image {
  display: grid;
  width: 64px;
  height: 64px;
  place-items: center;
  overflow: hidden;
  border-radius: 16px;
  background: var(--blue-100);
  color: var(--blue-700);
  font-weight: 950;
}

.mini-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cart-item h4 {
  margin: 0 0 4px;
  font-size: 15px;
}

.cart-item p {
  margin: 0 0 8px;
  color: var(--muted);
}

.quantity-row {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.quantity-row button {
  width: 28px;
  height: 28px;
  border-radius: 9px;
  background: white;
  color: var(--blue-800);
  font-weight: 950;
}

.quantity-row span {
  min-width: 18px;
  text-align: center;
  font-weight: 950;
}

.remove-item {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #ffe9e9;
  color: var(--red);
  font-size: 22px;
}

.cart-summary {
  display: grid;
  gap: 12px;
  padding-top: 18px;
  margin-top: 18px;
  border-top: 1px solid var(--line);
}

.cart-summary div {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-summary span {
  color: var(--muted);
}

.cart-summary strong {
  font-size: 20px;
}

.checkout-form,
.admin-form,
.auth-form {
  display: grid;
  gap: 12px;
}

.checkout-form {
  padding-top: 18px;
  margin-top: 18px;
  border-top: 1px solid var(--line);
}

.checkout-form h3 {
  margin: 0;
  font-size: 22px;
  letter-spacing: -0.04em;
}

.checkout-actions,
.auth-actions {
  display: grid;
  gap: 10px;
}

.check-row {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--blue-800);
  font-weight: 850;
}

.check-row input {
  width: auto;
}

.auth-card {
  display: grid;
  grid-template-columns: 0.9fr 1.3fr auto;
  gap: 18px;
  align-items: start;
  padding: 22px;
  margin-bottom: 22px;
}

.switch-auth {
  color: var(--blue-700);
  font-weight: 900;
  align-self: end;
}

.alert,
.global-message {
  margin: 0;
  padding: 12px 14px;
  border-radius: 16px;
  font-weight: 800;
}

.global-message {
  margin-bottom: 16px;
}

.success {
  background: #edfff8;
  color: #08734f;
}

.error {
  background: #fff0f0;
  color: #b91c1c;
}

.panel-page {
  padding: 26px;
  border-radius: var(--radius-xl);
  background: white;
  box-shadow: var(--shadow);
}

.table-card {
  overflow: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 720px;
}

th,
td {
  padding: 16px;
  border-bottom: 1px solid var(--line);
  text-align: left;
}

th {
  color: var(--muted);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.order-status {
  display: inline-flex;
  padding: 7px 10px;
  border-radius: 999px;
  background: var(--blue-100);
  color: var(--blue-800);
  font-size: 12px;
  font-weight: 950;
  text-transform: capitalize;
}

.order-status.pending {
  background: #fff7ed;
  color: #c2410c;
}

.order-status.validated {
  background: var(--blue-100);
  color: var(--blue-800);
}

.order-status.delivered {
  background: #edfff8;
  color: #08734f;
}

.order-status.cancelled {
  background: #fff0f0;
  color: #b91c1c;
}

.admin-grid {
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 20px;
  align-items: start;
  margin-bottom: 20px;
}

.admin-card {
  padding: 22px;
}

.admin-card h3 {
  margin-bottom: 16px;
  font-size: 26px;
}

.admin-list {
  display: grid;
  gap: 12px;
  max-height: 520px;
  overflow: auto;
}

.admin-order,
.stock-row {
  display: grid;
  gap: 12px;
  align-items: center;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--soft);
}

.admin-order {
  grid-template-columns: 1fr auto;
}

.admin-order p,
.stock-row p {
  margin: 4px 0 8px;
  color: var(--muted);
}

.admin-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.admin-actions button {
  padding: 9px 12px;
  border-radius: 999px;
  background: var(--blue-100);
  color: var(--blue-800);
  font-weight: 900;
}

.stock-grid {
  display: grid;
  gap: 12px;
}

.stock-row {
  grid-template-columns: 1.3fr 0.7fr 1fr auto;
}

@media (max-width: 1180px) {
  .site-header,
  .hero-section,
  .shop-layout,
  .admin-grid,
  .auth-card {
    grid-template-columns: 1fr;
  }

  .main-nav,
  .header-actions {
    justify-content: flex-start;
    flex-wrap: wrap;
  }

  .cart-card {
    position: static;
  }

  .filter-bar,
  .stock-row {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 760px) {
  .app-shell {
    padding: 12px;
  }

  .site-header {
    position: static;
    border-radius: 24px;
  }

  .hero-section {
    min-height: auto;
    padding: 24px;
  }

  .hero-copy h1 {
    font-size: 44px;
  }

  .store-stats,
  .admin-stats,
  .filter-bar,
  .stock-row,
  .admin-order {
    grid-template-columns: 1fr;
  }

  .section-title {
    align-items: start;
    flex-direction: column;
  }

  .product-grid {
    grid-template-columns: 1fr;
  }
}
